# Copy this file to .env. Fill every value before you run Docker Compose.
# Both database containers publish on 127.0.0.1 only, so these local passwords stay on the machine.

# --- Development ---

# App Database (app-db, host port 5432). Holds the Prisma-managed application data.
# Use only letters, digits, underscores, and hyphens in these values.
# Compose inserts these values into a PostgreSQL URL for the API containers.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Docker seeds the tenant database from seed-data/tenant_company/. The service publishes host port 5433.
# The tenant fixture creates the agent_readonly role for read-only table access.
# Use only letters, digits, underscores, and hyphens in these values.
TENANT_POSTGRES_USER=
TENANT_POSTGRES_PASSWORD=
TENANT_POSTGRES_DB=
