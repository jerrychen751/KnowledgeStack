# A host name or an IP address, such as 127.0.0.1.
HOST=
# An integer from 1 through 65535.
PORT=
# The maximum JSON request body size, such as 12mb. Defaults to 12mb.
REQUEST_BODY_LIMIT=
# The minimum Nest log level: verbose, debug, log, warn, error or fatal. Defaults to verbose.
LOG_LEVEL=
# The deployment name in startup logs, such as development, staging or production. Defaults to development.
DEPLOYMENT_NAME=

# A PostgreSQL URL for API queries.
DB_POOL_URL=
# A PostgreSQL URL for Prisma commands.
DB_DIRECT_URL=

# A 32-byte AES-256-GCM key, base64url encoded, that encrypts OAuth tokens before they reach Postgres.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
TOKEN_ENCRYPTION_KEY=
# Optional old keys for token decryption, as a comma-separated base64url list.
TOKEN_DECRYPTION_KEYS=

# The Google OAuth 2.0 client that signs a person in, from https://console.cloud.google.com/apis/credentials.
# auth/auth.service.ts reads both when a person signs in, and the API starts without them.
# config/app-config.ts derives the callback URL from WEB_APP_URL, so the deployment sets no redirect variable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The OAuth 2.0 (3LO) client of the Atlassian app that a Confluence source connects through.
# auth/oauth.registry.ts builds the variable name from the provider name, so every provider uses the same rule.
# It reads both only when a Confluence source connects or refreshes, so an unused connector needs no value.
# Register the connector callback URL that config/app-config.ts derives in the Atlassian developer console.
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=

# The public integration that a Notion source connects through, from https://www.notion.so/my-integrations.
# Register the connector callback URL that config/app-config.ts derives as a redirect URI on the integration.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# The OpenAI account that embeds document chunks and answers chat questions.
# embedding/embedding.service.ts reads it during every sync that finds a changed document.
OPENAI_API_KEY=

# The directory that holds uploaded files, relative to apps/api. Defaults to .uploads.
# The filesystem connector indexes it, so a chat answer can quote any file you write here.
UPLOAD_ROOT=
# The origin of the web app, where the OAuth callback returns the browser. Defaults to http://localhost:3000.
# config/app-config.ts also appends /api/sources/oauth/callback to it to build the one connector redirect URI.
# Notion rejects an IP address in a redirect URI and accepts localhost, so keep the host a name and open the web app at it.
WEB_APP_URL=
