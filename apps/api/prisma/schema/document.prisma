// PostgreSQL rejects a provider value until its enum migration commits.
enum DocumentSourceProvider {
  filesystem
  notion
  confluence
}

// Semantic category, not the vocabulary of the source; each connector maps its own types onto these three
enum DocumentType {
  page // fetchable as text
  database // structured rows, such as a Notion database
  attachment // binary, such as a PDF; readDocument cannot return text for it
}

enum SourceStatus {
  active
  reauth_required
  error
}

model DocumentSource {
  id                  String                 @id @default(cuid())
  provider            DocumentSourceProvider
  // The provider's id for the content container: a Notion workspace_id, an Atlassian cloudId, or a filesystem root path
  externalId          String                 @map("external_id")
  // A Confluence space id. The other providers leave this value null.
  externalSpaceId     String?                @map("external_space_id")
  // Mutable provider name, such as Notion workspace_name; never use it as an identifier
  externalDisplayName String                 @map("external_display_name")
  // Connector settings, such as an Atlassian site URL. Credentials never enter this value.
  config              Json                   @default("{}")
  status              SourceStatus           @default(active)
  // Start time of the last sync pass
  lastSyncedAt        DateTime?              @map("last_synced_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // One OAuth credential can supply several Confluence space sources. A filesystem source has no credential.
  credentialId String?           @map("credential_id")
  credential   SourceCredential? @relation(fields: [credentialId, tenantId, provider], references: [id, tenantId, provider], onDelete: Restrict)
  documents    Document[]

  @@unique([tenantId, provider, credentialId], map: "document_sources_notion_identity_key", where: raw("\"provider\" = 'notion'"))
  @@unique([tenantId, provider, externalId, externalSpaceId], map: "document_sources_confluence_identity_key", where: raw("\"provider\" = 'confluence' AND \"external_space_id\" IS NOT NULL"))
  @@unique([tenantId, provider, externalId], map: "document_sources_filesystem_identity_key", where: raw("\"provider\" = 'filesystem'"))
  @@index([tenantId])
  @@index([credentialId, tenantId, provider])
  @@map("document_sources")
}

model SourceCredential {
  id                  String                 @id @default(cuid())
  provider            DocumentSourceProvider
  // The authorization id: a Notion bot_id or an Atlassian account_id. A legacy Notion row stays null until reauthorization.
  externalId          String?                @map("external_id")
  externalDisplayName String                 @map("external_display_name")
  // The provider user that granted access. An internal Notion integration can leave both values null.
  externalUserId      String?                @map("external_user_id")
  externalUserEmail   String?                @map("external_user_email")

  encryptedAccessToken  String       @map("encrypted_access_token")
  encryptedRefreshToken String?      @map("encrypted_refresh_token")
  expiresAt             DateTime?    @map("expires_at")
  scope                 String?
  status                SourceStatus @default(active)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  tenantId String           @map("tenant_id")
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sources  DocumentSource[]

  @@unique([tenantId, provider, externalId])
  @@unique([id, tenantId, provider])
  @@index([tenantId])
  @@map("source_credentials")
}

model Document {
  id                 String       @id @default(cuid())
  externalId         String       @map("external_id") // id the source assigns, such as a Notion page id; unique only within one source
  externalTitle      String       @map("external_title")
  externalParentId   String?      @map("external_parent_id")
  externalParentType String?      @map("external_parent_type")
  externalUrl        String       @map("external_url") // deep link into the source; a citation shows it and readDocument re-fetches through it
  documentType       DocumentType @map("document_type")
  // Edit time the provider reports, unlike updatedAt below which is the edit time of this row
  externalUpdatedAt  DateTime     @map("external_updated_at")
  // Time the chunks were last written; the gap from externalUpdatedAt to here is the staleness of this document
  lastIndexedAt      DateTime?    @map("last_indexed_at")
  // Stamped with the start time of every full reconcile pass that lists this document
  lastSeenAt         DateTime     @map("last_seen_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  documentSourceId String          @map("document_source_id")
  documentSource   DocumentSource  @relation(fields: [documentSourceId], references: [id], onDelete: Cascade)
  chunks           DocumentChunk[]

  @@unique([documentSourceId, externalId])
  // The reconcile sweep reads the rows of one source whose lastSeenAt predates the start of the pass
  @@index([documentSourceId, lastSeenAt])
  @@map("documents")
}

model DocumentChunk {
  id          String                       @id @default(cuid())
  chunkIndex  Int                          @map("chunk_index") // 0-based and contiguous, because a re-embed deletes every chunk of the document and re-inserts
  text        String // raw chunk text; the embed step prepends externalTitle and headingPath before it calls OpenAI
  tokenCount  Int                          @map("token_count")
  // Ordered Markdown headings above this chunk, outermost first; empty when the chunk came from plain text
  headingPath String[]                     @map("heading_path")
  // The migration defines an HNSW cosine index because Prisma cannot index this Unsupported field
  // Prisma Client cannot read or write this field, so ingestion and search use raw SQL
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime                     @default(now()) @map("created_at")

  documentId String   @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@map("document_chunks")
}
