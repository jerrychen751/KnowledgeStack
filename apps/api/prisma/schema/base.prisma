// Normally prisma/schema.prisma contains all table definitions
// But we split it up into multiple logically-grouped files
// This requires a base.prisma to configure for all table schema files

datasource db {
    provider = "postgresql"
    extensions = [vector] // pgvector; supplies the vector(1536) type on DocumentChunk.embedding
}

generator client {
    provider = "prisma-client"
    output = "../../src/generated/prisma" // relative to location of this prisma file
    previewFeatures = ["postgresqlExtensions"] // required before Prisma emits CREATE EXTENSION in a migration
}
