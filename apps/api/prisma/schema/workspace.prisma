model Workspace {
  // Prisma marks this field as the primary key and generates a cuid when the write gives no value
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // a unique url-safe identifier
  // The code a member gives to a new person, such as "K7QW2M4D"; workspace.service.ts normalizes typed input before it compares
  joinCode  String   @unique @map("join_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // This is a relation field; it does not create a column in the Workspace table
  // Prisma makes a field a relation from its type
  chats               Chat[]
  databaseConnections DatabaseConnection[]
  credentials         SourceCredential[]
  memberships         WorkspaceMembership[]
  sessions            UserSession[]
  sources             Source[]

  @@map("workspaces")
}

// One Google account. The row outlives every workspace the person joins, so it holds no workspace column.
model User {
  id                  String   @id @default(cuid())
  // Google's "sub" claim. The address in externalEmail changes when the person renames the account, so it cannot key this row.
  externalId          String   @unique @map("external_id")
  externalEmail       String   @map("external_email")
  externalDisplayName String   @map("external_display_name")
  externalImageUrl    String?  @map("external_image_url")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  chats       Chat[]
  memberships WorkspaceMembership[]
  sessions    UserSession[]

  @@map("users")
}

model WorkspaceMembership {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mcpTokens   McpToken[]

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_memberships")
}

// One signed-in browser. The cookie carries the token and this row keeps only its SHA-256, so a database
// dump signs nobody in.
model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  userId            String     @map("user_id")
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The workspace this browser reads, null until the person creates or joins one
  activeWorkspaceId String?    @map("active_workspace_id")
  activeWorkspace   Workspace? @relation(fields: [activeWorkspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("user_sessions")
}

// One MCP client. The client sends the token as a bearer credential and this row keeps only its SHA-256.
// The token belongs to the membership that created it, not to the person and the workspace separately, so
// leaving the workspace deletes it. A person who rejoins gets a new membership, which authorizes no token
// the old one issued. The workspace is fixed through that membership and never moves, unlike
// UserSession.activeWorkspaceId which the browser changes.
model McpToken {
  id         String    @id @default(cuid())
  name       String
  hash       String    @unique
  expiresAt  DateTime  @map("expires_at")
  // Null until an MCP client sends its first message with this token, which is its handshake and not a tool call
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  membershipId String              @map("membership_id")
  membership   WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId])
  @@map("mcp_tokens")
}
