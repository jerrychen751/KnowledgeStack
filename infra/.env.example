# Copy this file to infra/.env and fill every value. scripts/apply-azure-infrastructure.mjs reads it when it applies infra/main.bicep.
# Git ignores infra/.env, and no value here reaches GitHub.

# The password of the Postgres admin login ksadmin. The Bicep file places it inside a URL, so use only letters, digits, underscores and hyphens.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
POSTGRES_ADMIN_PASSWORD=

# The key that encrypts every stored OAuth token and database password. Generate it the same way, once, and keep it:
# a different key on a later apply makes every stored secret unreadable. Use a new key here, so the laptop and Azure share none.
TOKEN_ENCRYPTION_KEY=

# The same values as apps/api/.env.
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Leave a connector's two values empty to deploy without it.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=
